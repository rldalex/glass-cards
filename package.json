{
  "name": "glass-cards",
  "version": "0.0.238",
  "private": true,
  "type": "module",
  "description": "A modular UI framework for Home Assistant",
  "license": "MIT",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/build-panel.mjs",
    "build:cards": "vite build",
    "postbuild": "node scripts/copy-bundles.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:backend": "python -m pytest tests/ -v",
    "test": "pnpm test:backend",
    "check": "pnpm typecheck && pnpm lint"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mdi/js": "^7.4.47",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "agentation": "^3.0.2",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "lit": "^3.2.1",
    "prettier": "^3.8.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "terser": "^5.46.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1"
  }
}
